---
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const temiyageItems = await getCollection('temiyage', ({ data }) => !data.draft);
const restaurantItems = await getCollection('restaurant', ({ data }) => !data.draft);

const searchData = [
  ...temiyageItems.map(item => ({
    title: item.data.title,
    tags: item.data.tags,
    category: item.data.category,
    area: item.data.area || '',
    excerpt: item.data.excerpt || '',
    href: `${base}temiyage/${item.id}/`,
    type: '手土産',
  })),
  ...restaurantItems.map(item => ({
    title: item.data.title,
    tags: item.data.tags,
    category: item.data.category,
    area: item.data.area || '',
    excerpt: item.data.excerpt || '',
    href: `${base}restaurant/${item.id}/`,
    type: 'レストラン',
  })),
];
---

<div class="search-container">
  <input type="text" id="search-input" placeholder="キーワードで検索..." class="search-input" />
  <div id="search-results" class="search-results"></div>
</div>

<script type="application/json" id="search-data" set:html={JSON.stringify(searchData)} />

<script>
  async function initSearch() {
    const Fuse = (await import('fuse.js')).default;
    const dataEl = document.getElementById('search-data');
    const input = document.getElementById('search-input') as HTMLInputElement;
    const resultsEl = document.getElementById('search-results');
    if (!dataEl || !input || !resultsEl) return;

    const items = JSON.parse(dataEl.textContent || '[]');
    const fuse = new Fuse(items, {
      keys: [
        { name: 'title', weight: 0.5 },
        { name: 'tags', weight: 0.2 },
        { name: 'category', weight: 0.1 },
        { name: 'area', weight: 0.1 },
        { name: 'excerpt', weight: 0.1 },
      ],
      threshold: 0.4,
    });

    input.addEventListener('input', () => {
      const query = input.value.trim();
      if (!query) {
        resultsEl.innerHTML = '';
        return;
      }
      const results = fuse.search(query);
      resultsEl.innerHTML = results.length
        ? results.map(r => `
            <a href="${r.item.href}" class="search-result-card">
              <span class="result-type">${r.item.type}</span>
              <span class="result-title">${r.item.title}</span>
              ${r.item.area ? `<span class="result-area">${r.item.area}</span>` : ''}
            </a>
          `).join('')
        : '<p class="no-results">該当する結果がありません</p>';
    });
  }
  initSearch();
</script>

<style>
  .search-container {
    max-width: 600px;
    margin: 0 auto;
  }

  .search-input {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    font-family: var(--font-sans);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background-color: var(--color-bg-secondary);
    color: var(--color-text);
    outline: none;
    transition: border-color 0.2s;
  }

  .search-input:focus {
    border-color: var(--color-primary);
  }

  .search-results {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .search-result-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background-color: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s;
  }

  .search-result-card:hover {
    box-shadow: var(--shadow-sm);
    color: inherit;
  }

  .result-type {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-primary);
    background-color: var(--color-tag-bg);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius);
    flex-shrink: 0;
  }

  .result-title {
    font-weight: 500;
    font-size: 0.95rem;
  }

  .result-area {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-left: auto;
  }

  .no-results {
    text-align: center;
    color: var(--color-text-muted);
    padding: 1rem;
  }
</style>
