---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  shopName?: string;
  price?: string;
  area?: string;
  occasion?: string;
  cuisine?: string;
  reservation?: string;
  address?: string;
  shopUrl?: string;
  image?: string;
  images?: string[];
  collectionLabel: string;
  collectionHref: string;
}

const {
  title, date, updatedDate, category, tags,
  shopName, price, area, occasion, cuisine, reservation, address, shopUrl, image, images,
  collectionLabel, collectionHref,
} = Astro.props;

const galleryImages = images && images.length > 0 ? images : image ? [image] : [];

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const dateStr = date.toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' });
const updatedStr = updatedDate?.toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' });

const infoItems = [
  { label: '店舗', value: shopName },
  { label: '価格帯', value: price },
  { label: 'エリア', value: area },
  { label: '用途', value: occasion },
  { label: 'ジャンル', value: cuisine },
  { label: '予約', value: reservation },
].filter(item => item.value);
---

<BaseLayout title={title}>
  <nav class="breadcrumb">
    <a href={base}>ホーム</a>
    <span class="sep">/</span>
    <a href={collectionHref}>{collectionLabel}</a>
    <span class="sep">/</span>
    <span>{title}</span>
  </nav>

  {galleryImages.length > 0 && (
    <div class={`hero-image ${galleryImages.length > 1 ? 'gallery' : ''}`}>
      {galleryImages.length === 1 ? (
        <img src={galleryImages[0]} alt={title} />
      ) : (
        <div class="gallery-fade" id="gallery">
          {galleryImages.map((src, i) => (
            <img src={src} alt={`${title} ${i + 1}`} class={i === 0 ? 'active' : ''} />
          ))}
        </div>
      )}
    </div>
  )}

  <article class="item-detail">
    <header class="item-header">
      <span class="category-badge">{category}</span>
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={date.toISOString()}>{dateStr}</time>
        {updatedStr && <span class="updated">（更新: {updatedStr}）</span>}
      </div>
    </header>

    {infoItems.length > 0 && (
      <div class="info-table">
        {infoItems.map(item => (
          <div class="info-row">
            <span class="info-label">{item.label}</span>
            <span class="info-value">{item.value}</span>
          </div>
        ))}
        {shopUrl && (
          <div class="info-row">
            <span class="info-label">公式サイト</span>
            <span class="info-value"><a href={shopUrl} target="_blank" rel="noopener noreferrer">こちら</a></span>
          </div>
        )}
      </div>
    )}

    <div class="item-content">
      <slot />
    </div>

    {tags.length > 0 && (
      <div class="tag-list">
        {tags.map(tag => (
          <a href={`${base}tags/${tag}/`} class="tag">#{tag}</a>
        ))}
      </div>
    )}

    {address && (
      <div class="map-container">
        <h2>アクセス</h2>
        <p class="map-address">{address}</p>
        <iframe
          src={`https://maps.google.com/maps?q=${encodeURIComponent(address)}&output=embed`}
          width="100%"
          height="300"
          style="border: 0; border-radius: var(--radius);"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`${shopName || title}の地図`}
        ></iframe>
      </div>
    )}
  </article>

  <script>
    const gallery = document.getElementById('gallery');
    if (gallery) {
      const imgs = gallery.querySelectorAll('img');
      if (imgs.length > 1) {
        let current = 0;
        setInterval(() => {
          imgs[current].classList.remove('active');
          current = (current + 1) % imgs.length;
          imgs[current].classList.add('active');
        }, 4000);
      }
    }
  </script>
</BaseLayout>

<style>
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: var(--color-text-muted); }
  .breadcrumb a:hover { color: var(--color-primary); }
  .breadcrumb .sep { margin: 0 0.4rem; }

  .hero-image {
    margin-bottom: 2rem;
    border-radius: var(--radius);
    overflow: hidden;
    max-height: 400px;
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-image.gallery {
    position: relative;
    height: 400px;
  }
  .gallery-fade {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .gallery-fade img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 400px;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .gallery-fade img.active {
    opacity: 1;
  }

  .item-header {
    margin-bottom: 2rem;
  }

  .category-badge {
    display: inline-block;
    background-color: var(--color-primary);
    color: #fff;
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius);
    margin-bottom: 0.5rem;
  }

  .item-header h1 {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .meta {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .updated { margin-left: 0.5rem; }

  .info-table {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
  }

  .info-row {
    display: flex;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .info-row:last-child { border-bottom: none; }

  .info-label {
    font-weight: 500;
    width: 100px;
    flex-shrink: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .info-value {
    font-size: 0.9rem;
  }

  .map-container {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .map-container h2 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }
  .map-address {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .item-content {
    line-height: 2;
    margin-bottom: 2rem;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .tag {
    background-color: var(--color-tag-bg);
    color: var(--color-tag-text);
    font-size: 0.8rem;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius);
  }
  .tag:hover {
    background-color: var(--color-border);
    color: var(--color-accent);
  }
</style>
